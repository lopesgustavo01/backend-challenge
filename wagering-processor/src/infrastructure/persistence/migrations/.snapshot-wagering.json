          "definition": "check (\"kind\" in ('OPENING', 'BET', 'WIN', 'LOSS', 'REFUND', 'ROLLBACK'))",
          "columnName": "kind"
        },
        {
          "name": "wager_tx_processed_at_by_status",
          "expression": "(status = 'PROCESSED'::text) = (processed_at IS NOT NULL)",
          "definition": "CHECK (((status = 'PROCESSED'::text) = (processed_at IS NOT NULL)))",
          "columnName": "processed_at"
        },
        {
          "name": "wager_tx_reference_by_kind",
          "expression": "\nCASE\n    WHEN (kind = ANY (ARRAY['REFUND'::text, 'ROLLBACK'::text])) THEN ((reference_external_transaction_id IS NOT NULL) AND (reference_external_transaction_id <> ''::text))\n    WHEN (kind = ANY (ARRAY['BET'::text, 'OPENING'::text])) THEN (reference_external_transaction_id IS NULL)\n    ELSE true\nEND",
          "definition": "CHECK (\nCASE\n    WHEN (kind = ANY (ARRAY['REFUND'::text, 'ROLLBACK'::text])) THEN ((reference_external_transaction_id IS NOT NULL) AND (reference_external_transaction_id <> ''::text))\n    WHEN (kind = ANY (ARRAY['BET'::text, 'OPENING'::text])) THEN (reference_external_transaction_id IS NULL)\n    ELSE true\nEND)",
          "columnName": "kind"
        },
        {
          "name": "wager_tx_reversal_has_reference",
          "expression": "NOT ((kind = ANY (ARRAY['REFUND'::text, 'ROLLBACK'::text])) AND (status = 'PROCESSED'::text) AND (reference_transaction_id IS NULL))",
          "definition": "CHECK ((NOT ((kind = ANY (ARRAY['REFUND'::text, 'ROLLBACK'::text])) AND (status = 'PROCESSED'::text) AND (reference_transaction_id IS NULL))))",
          "columnName": "kind"
        },
        {
          "name": "wager_tx_status_valid",
          "expression": "\"status\" in ('PENDING', 'PENDING_REFERENCE', 'PROCESSED', 'REJECTED', 'FAILED')",
          "definition": "check (\"status\" in ('PENDING', 'PENDING_REFERENCE', 'PROCESSED', 'REJECTED', 'FAILED'))",
          "columnName": "status"
        }
